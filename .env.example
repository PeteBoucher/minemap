# Copy to .env.local for local builds. Both are public (they end up in the app).
# Public key that verifies unlock licences (from scripts/gen-license-keys.ts)
VITE_LICENSE_PUBLIC_JWK=
# Stripe Payment Link the "Unlock for $5" button opens, e.g. https://buy.stripe.com/test_...
VITE_STRIPE_PAYMENT_LINK=
