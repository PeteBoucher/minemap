# Copy to .env.local (never committed). `npm run dev` reads the VITE_ lines; `vercel dev` reads all of them.

# --- Public: built into the app ---
# Public key that verifies unlock licences (from scripts/gen-license-keys.ts)
VITE_LICENSE_PUBLIC_JWK=
# Stripe Payment Link the "Unlock for $5" button opens, e.g. https://buy.stripe.com/test_...
VITE_STRIPE_PAYMENT_LINK=

# --- Secret: server only (api/), never prefix these with VITE_ ---
STRIPE_SECRET_KEY=
LICENSE_PRIVATE_JWK=
# Optional: only sessions from this Payment Link unlock
STRIPE_PAYMENT_LINK_ID=

# Optional: audit trail of unlocks and restores in PostHog (project API key, phc_…). Off when unset.
POSTHOG_KEY=
# PostHog ingestion host; defaults to https://eu.i.posthog.com
POSTHOG_HOST=

# --- End-to-end test (scripts/e2e-purchase.ts), against a Vercel Preview with sandbox keys ---
# Uses STRIPE_SECRET_KEY and STRIPE_PAYMENT_LINK_ID above, which must be the sandbox (test) values
# Vercel: Settings > Deployment Protection > Protection Bypass for Automation
VERCEL_AUTOMATION_BYPASS_SECRET=
# Optional: phx_ key with query:read, to check the audit event
POSTHOG_PERSONAL_API_KEY=
